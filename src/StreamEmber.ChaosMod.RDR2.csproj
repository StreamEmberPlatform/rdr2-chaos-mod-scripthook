<Project Sdk="Microsoft.NET.Sdk">

  <!-- StreamEmber Chaos Mod (RDR2): a StreamEmber Runtime script with an MHud menu page in the
       StreamEmber Overlay. Installed into <game>\StreamEmber\Scripts (build.ps1). The page itself is published to
       GitHub Pages (web/), not installed. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StreamEmber.ChaosMod.RDR2</AssemblyName>
    <RootNamespace>StreamEmber.ChaosMod</RootNamespace>
    <Product>StreamEmber Chaos Mod (RDR2)</Product>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Compile-time references only (never copied): the game loads them from StreamEmber\Runtime and
         StreamEmber\Scripts. build.ps1 passes the released files (CI) or the sibling builds (local). -->
    <ScriptingReference Condition="'$(ScriptingReference)' == ''">$(MSBuildThisFileDirectory)..\..\rdr2-runtime-scripthook\bin\Release\StreamEmber.Scripting.RDR2.dll</ScriptingReference>
    <BridgeReference Condition="'$(BridgeReference)' == ''">$(MSBuildThisFileDirectory)..\..\ui-runtime\build\managed\StreamEmber.Overlay.Bridge.dll</BridgeReference>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="StreamEmber.Scripting.RDR2">
      <HintPath>$(ScriptingReference)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StreamEmber.Overlay.Bridge">
      <HintPath>$(BridgeReference)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <Target Name="CheckReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ScriptingReference)')"
           Text="StreamEmber.Scripting.RDR2.dll not found: $(ScriptingReference). Build rdr2-runtime-scripthook or pass -p:ScriptingReference=..." />
    <Error Condition="!Exists('$(BridgeReference)')"
           Text="StreamEmber.Overlay.Bridge.dll not found: $(BridgeReference). Build ui-runtime or pass -p:BridgeReference=..." />
  </Target>

</Project>
